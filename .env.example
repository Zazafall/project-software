# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Flask Environment & Secrets
FLASK_ENV="development"
FLASK_APP="backend.app:app"
SECRET_KEY="REPLACE_WITH_STRONG_RANDOM_SECRET_KEY"

# MySQL Database Configuration
# In production, specify MySQL connection parameters.
# Example: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="sec_3fa_user"
MYSQL_PASSWORD="REPLACE_WITH_STRONG_MYSQL_PASSWORD"
MYSQL_DATABASE="three_factor_access_control"
# Optional full connection URI override:
# DATABASE_URL="mysql+pymysql://sec_3fa_user:PASSWORD@localhost:3306/three_factor_access_control"

# Timezone Configuration (for consistent timestamp display)
TIMEZONE="UTC"

# Security & 3FA Parameters
BIOMETRIC_DEFAULT_THRESHOLD="0.60"
MAX_FAILED_PIN_ATTEMPTS="5"
DOOR_RELAY_PULSE_MS="5000"
HARDWARE_MODE="simulation" # 'simulation' or 'gpio'

